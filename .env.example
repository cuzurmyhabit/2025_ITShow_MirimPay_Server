# Copy to .env, then fill values locally. Blank required values fail at startup.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=
DB_PASSWORD=
DB_NAME=mirim_pay
PORT=3000
# Generate independent random secrets locally (at least 32 characters each).
JWT_SECRET=
ENCRYPTION_SECRET_KEY=
# Server-side Toss secret, never a public payment client key.
TOSS_SECRET_KEY=
# For Docker Compose, set DB_HOST=postgres, DB_PORT=5432 and PORT=8080.
